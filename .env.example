GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Microsoft sign-in. Keep the secret on the Python server only.
# Register this exact Web callback in Microsoft Entra before enabling it.
# GENIE_MICROSOFT_CLIENT_ID=
# GENIE_MICROSOFT_CLIENT_SECRET=
# GENIE_MICROSOFT_TENANT=common
# GENIE_MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback

# Optional workspace invitation email. Install azure-communication-email==1.1.0.
# Keep the connection string on the Python server only. See docs/email.md.
# GENIE_EMAIL_CONNECTION_STRING=
# GENIE_EMAIL_SENDER=DoNotReply@your-generated-domain.azurecomm.net
# GENIE_EMAIL_REPLY_TO=
# GENIE_EMAIL_DAILY_LIMIT=100

# Leave these unset for the normal local application.
# Azure injects its actual WEBSITE_HOSTNAME; no public URL needs to be guessed.
# GENIE_PUBLIC_URL=https://your-app.azurewebsites.net
# GENIE_CLOUD_STATE=azure_sql
# GENIE_DATA_DIR=/tmp/data-genie
# GENIE_SQL_HOST=your-sql-server.database.windows.net
# GENIE_SQL_DATABASE=data-genie-state
# GENIE_SQL_USER=genieadmin
# GENIE_SQL_PASSWORD=managed-by-terraform
# GENIE_CONNECTION_KEY=managed-by-terraform
